# این فایل را کپی کنید به ".env" و مقادیر واقعی پروژه Supabase خودتان را وارد کنید.
# ".env" نباید commit شود (در .gitignore هست).

# آدرس Edge Function های پروژه — معمولاً به شکل زیر است:
# https://<project-ref>.supabase.co/functions/v1
VITE_SUPABASE_FUNCTIONS_URL=

# کلید anon پروژه (از Project Settings → API در داشبورد Supabase)
# این کلید عمومی و امن برای مرورگر است — با service_role key اشتباه نگیرید.
VITE_SUPABASE_ANON_KEY=
